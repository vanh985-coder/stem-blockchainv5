# Sao chép thành deploy/.env trên server (KHÔNG commit). Các biến này được "đóng cứng" vào bản build.
# Đổi giá trị thì phải build lại: docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build

# Địa chỉ 6 phần (https, qua Cloudflare Tunnel)
VITE_HUB_URL=https://stem-block.blockchainptit.com
VITE_LANG_GIAY_URL=https://sb-lang-giay.blockchainptit.com
VITE_LANG_DET_URL=https://sb-lang-det.blockchainptit.com
VITE_LANG_KHAC_DAU_URL=https://sb-lang-khac-dau.blockchainptit.com
VITE_LANG_BAC_URL=https://sb-lang-bac.blockchainptit.com
VITE_ASSETS_URL=https://sb-assets.blockchainptit.com

# Cổng trên server (chỉ mở ở 127.0.0.1; cloudflared trỏ hostname vào các cổng này). Mặc định như dưới đây.
# Đổi nếu cổng đã có chương trình khác dùng (kiểm tra: netstat -ano | findstr :1808). Không cần build lại khi chỉ đổi cổng.
HUB_PORT=18081
LANG_GIAY_PORT=18082
LANG_DET_PORT=18083
LANG_KHAC_DAU_PORT=18084
LANG_BAC_PORT=18085
ASSETS_PORT=18086

# Cookie đăng nhập dùng chung cho mọi subdomain (có dấu chấm ở đầu)
VITE_COOKIE_DOMAIN=.blockchainptit.com

# Supabase: chỉ dùng khóa công khai (publishable/anon). KHÔNG bao giờ để service role ở đây.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Tên miền email nội bộ của tài khoản tên đăng nhập. Phải giống secret USERNAME_EMAIL_DOMAIN của Edge Function.
VITE_USERNAME_EMAIL_DOMAIN=hs.blockchainptit.com

# Đặt true sau khi gộp web (spec 10); mốc 1 để false
VITE_MERGED=false
