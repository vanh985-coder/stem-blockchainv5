# Bản chạy thử localhost trên server. Sao chép thành deploy/.env.local (KHÔNG commit; .env.local đã nằm trong .gitignore) rồi điền 2 dòng Supabase.
# Đổi giá trị thì phải dựng lại: docker compose -f docker-compose.local.yml --env-file .env.local up -d --build

# Địa chỉ 6 phần (http, localhost)
VITE_HUB_URL=http://localhost:19081
VITE_LANG_GIAY_URL=http://localhost:19082
VITE_LANG_DET_URL=http://localhost:19083
VITE_LANG_KHAC_DAU_URL=http://localhost:19084
VITE_LANG_BAC_URL=http://localhost:19085
VITE_ASSETS_URL=/do-hoa

# Cổng trên server (chỉ mở ở 127.0.0.1). Khác dải cổng của bản thật nên chạy song song được.
HUB_PORT=19081
LANG_GIAY_PORT=19082
LANG_DET_PORT=19083
LANG_KHAC_DAU_PORT=19084
LANG_BAC_PORT=19085
ASSETS_PORT=19086

# Để trống: cookie đăng nhập không dùng chung giữa các cổng localhost
VITE_COOKIE_DOMAIN=

# Supabase: người chạy tự điền (khóa publishable/anon, KHÔNG dùng service role). Không commit giá trị thật.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Giống bản thật
VITE_USERNAME_EMAIL_DOMAIN=hs.blockchainptit.com

# Bản gộp web
VITE_MERGED=true
