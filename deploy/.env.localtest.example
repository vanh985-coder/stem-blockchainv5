# Chạy thử Docker ngay trên máy (cổng localhost, http, không có tên miền).
# Sao chép thành deploy/.env.localtest (KHÔNG commit), điền 2 dòng Supabase rồi chạy:
#   docker compose --env-file deploy/.env.localtest -f deploy/docker-compose.yml up -d --build
# Lưu ý: đăng nhập Google chỉ chạy được khi Supabase cho phép http://localhost:18081/** ở Redirect URLs.

# Cổng trên máy mặc định 18081–18086 (HUB_PORT… xem deploy/.env.example); địa chỉ dưới đây phải khớp.
VITE_HUB_URL=http://localhost:18081
VITE_LANG_GIAY_URL=http://localhost:18082
VITE_LANG_DET_URL=http://localhost:18083
VITE_LANG_KHAC_DAU_URL=http://localhost:18084
VITE_LANG_BAC_URL=http://localhost:18085
VITE_ASSETS_URL=http://localhost:18086
VITE_COOKIE_DOMAIN=

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx
VITE_USERNAME_EMAIL_DOMAIN=hs.blockchainptit.com
VITE_MERGED=false
