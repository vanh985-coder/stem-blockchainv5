# Sao chép thành .env.local (không commit). Một file ở gốc repo dùng chung cho cả 5 app khi chạy trên máy.
# Trên Vercel: nhập các biến này ở Settings -> Environment Variables của từng project.

# Spec 02. Chỉ dùng khóa công khai (anon/publishable), KHÔNG dùng service role hay secret key.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx
# Tên miền email nội bộ của tài khoản tên đăng nhập: email = <ten>@<giá trị này>. Học sinh không bao giờ thấy.
# Không gửi email thật; chỉ cần là tên miền hợp lệ. Ví dụ: hs.ten-mien.vn
VITE_USERNAME_EMAIL_DOMAIN=hs.ten-mien.vn
# Edge Function teacher-reset-password cũng cần cùng giá trị này, đặt bằng: supabase secrets set USERNAME_EMAIL_DOMAIN=hs.ten-mien.vn
# (service role key CHỈ có trong Edge Function, không bao giờ để trong file này).

# Đồ họa: lúc dev chạy `pnpm dev:assets` ở cổng 5180
VITE_ASSETS_URL=http://localhost:5180

# Web chính
VITE_HUB_URL=http://localhost:5173

# Để trống khi chạy localhost; trên môi trường thật: .ten-mien.vn
VITE_COOKIE_DOMAIN=

# Đặt true sau khi gộp web (spec 10)
VITE_MERGED=false

# Địa chỉ 4 làng (hub dùng để dẫn tới màn bài học). Thêm ngoài bảng mục 6 vì ở localhost mỗi làng một cổng.
# Trên môi trường thật: https://lang-giay.ten-mien.vn ...
VITE_LANG_GIAY_URL=http://localhost:5174
VITE_LANG_DET_URL=http://localhost:5175
VITE_LANG_KHAC_DAU_URL=http://localhost:5176
VITE_LANG_BAC_URL=http://localhost:5177

# Chỉ dùng cho `pnpm rls:check` (phần giáo viên): hai tài khoản giáo viên thật, đăng nhập bằng email + mật khẩu. Không commit .env.local.
TEST_TEACHER_A_EMAIL=
TEST_TEACHER_A_PASSWORD=
TEST_TEACHER_B_EMAIL=
TEST_TEACHER_B_PASSWORD=
