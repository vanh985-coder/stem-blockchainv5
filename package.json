{
  "name": "so-chung",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:hub": "pnpm --filter @so-chung/hub dev",
    "dev:lang-giay": "pnpm --filter @so-chung/lang-giay dev",
    "dev:lang-det": "pnpm --filter @so-chung/lang-det dev",
    "dev:lang-khac-dau": "pnpm --filter @so-chung/lang-khac-dau dev",
    "dev:lang-bac": "pnpm --filter @so-chung/lang-bac dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "crop-portraits": "node scripts/crop-portraits.mjs",
    "assets:build": "node scripts/assets-build.mjs",
    "dev:assets": "node scripts/dev-assets.mjs",
    "check:text": "node scripts/check-text.mjs",
    "rls:check": "node scripts/rls-check.mjs",
    "brand:build": "node scripts/brand-images.mjs",
    "guide:capture": "node scripts/guide-capture.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@supabase/supabase-js": "^2.117.2",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
